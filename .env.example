APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=traffic_report
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. "log" only writes emails to storage/logs (safe default). Use "smtp" to really send. See docs/email-report.md.
# Put the real values in .env only, never in this file.
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
# Laravel 11+ reads MAIL_SCHEME (smtp = STARTTLS on 587, smtps = TLS on 465). MAIL_ENCRYPTION is the older name for the same
# idea (tls or ssl); it is kept here as a reminder and is not read by Laravel 13.
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="reports@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Traffic report automation
# Secret for the X-Cron-Token header (64 hex chars): php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
REPORT_MAX_ATTEMPTS=3
REPORT_RETRY_WINDOW_DAYS=45
REPORT_GSC_DELAY_DAYS=3
REPORT_HEARTBEAT_URL=
REPORT_GOOGLE_RETRY_ATTEMPTS=4
REPORT_GOOGLE_RETRY_DELAY_MS=500
REPORT_CHARTS_ENABLED=true
# REPORT_CHARTS_BASE_URL=https://quickchart.io
# REPORT_CHARTS_TIMEOUT=10
